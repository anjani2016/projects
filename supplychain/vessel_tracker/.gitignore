# ==============================================================================
# 1. LOCAL ENVIRONMENT VARIABLES & SENSITIVE CREDENTIALS
# ==============================================================================
# Never commit raw secrets, keys, or local configuration overrides
.env
.env.local
.env.development
.env.test
.env.production
*.env
*.pem
*.key
*.cert
*.secret

# ==============================================================================
# 2. LOCAL ENVIRONMENT FOLDERS (VIRTUAL ENVS & NODE DEPENDENCIES)
# ==============================================================================
# Python Virtual Environments (Isolated machine engines)
.venv/
venv/
ENV/
vessel_env/
bin/
lib/
lib64/
share/python-wheels/

# TypeScript / JavaScript Node Modules (Installed via npm install)
node_modules/
/jspm_packages/
/web_modules/

# ==============================================================================
# 3. AI AGENTS & IDE SYSTEM CACHES (Excludes Global Logic Rules)
# ==============================================================================
# Hide editor configurations and local model logging artifacts
.agent/
.cursor/
.vscode/*
!.vscode/extensions.json
.idea/
.antigravity/
.clinerules
.copilot-instructions

# ==============================================================================
# 4. TESTING & COMPILATION ARTIFACTS
# ==============================================================================
# Python cache and testing footprints
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.tox/
.coverage
htmlcov/
.build/

# Log files generated by runtimes
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================================================================
# 5. OS SYSTEM TRASH & METADATA
# ==============================================================================
# Operating system background indexing trackers
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db